{
	"name": "TuneJournal",
	"short_name": "TuneJournal",
	"description": "Track the folk tunes you play, want to learn, and have heard.",
	"start_url": "./",
	"scope": "./",
	"display": "standalone",
	"theme_color": "#2f6f5e",
	"background_color": "#fbf8f1",
	"share_target": {
		"action": "share-target",
		"method": "POST",
		"enctype": "multipart/form-data",
		"params": {
			"title": "title",
			"text": "text",
			"url": "url",
			"files": [
				{
					"name": "audio",
					"accept": ["audio/*", ".m4a", ".mp3", ".wav", ".ogg", ".opus", ".aac", ".flac"]
				}
			]
		}
	},
	"icons": [
		{ "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" },
		{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
		{ "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
		{
			"src": "icons/icon-maskable-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "maskable"
		}
	]
}
